# 管理画面ログイン情報
ADMIN_URL=https://sacoche-sacolla.flumo-admin-server.com/login
ADMIN_USER=your_login_id
ADMIN_PASS=your_password

# 検索キーワード（カンマ区切りで複数指定可）
SEARCH_KEYWORDS=サコッシュ,ポーチ

# 1回の実行で追加する商品数
ADD_LIMIT=10

# スケジュール実行時刻（24時間表記）
SCHEDULE_TIME=09:00

# ブラウザをヘッドレスで動かすか（True=バックグラウンド, False=画面表示）
HEADLESS=True
